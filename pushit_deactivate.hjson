{
  type: 'pushit_deactivate'
  module: 'pushit'
  action: 'deactivate'
  groupTitle: 'Mr Cheese'
  groupIcon: 'fas fa-lg fa-cheese comp-exec'
  title: 'PuSH-IT Deactivate Subscription'
  icon: 'fas fa-lg fa-bell-slash comp-data'
  outputType: 'object'

  help: 'Resolve browser push endpoint from POST for Database Update (set active = 0). Bind {{$_POST.subscription}} or {{$_POST.endpoint}} from the unsubscribe API.'

  dataScheme: [
    {name: 'success', type: 'boolean'}
    {name: 'valid', type: 'boolean'}
    {name: 'endpoint', type: 'text'}
    {name: 'userUUID', type: 'text'}
    {name: 'entityId', type: 'text'}
    {name: 'error', type: 'text'}
  ]

  dataPickObject: true

  properties: [
    {
      group: 'Settings'
      variables: [
        {
          name: 'actionName'
          optionName: 'name'
          title: 'Name'
          type: 'text'
          required: true
          defaultValue: ''
          baseName: 'pushDeactivate'
          help: 'Step name for bindings (e.g. {{pushDeactivate.endpoint}})'
        }
        {
          name: 'actionOutput'
          optionName: 'output'
          title: 'Output'
          type: 'boolean'
          initValue: true
          defaultValue: false
        }
      ]
    }
    {
      group: 'Unsubscribe (from browser POST)'
      variables: [
        {
          name: 'subscription'
          optionName: 'subscription'
          title: 'Subscription JSON'
          type: 'textarea'
          serverDataBindings: true
          defaultValue: ''
          help: 'Bind {{$_POST.subscription}} from the client unsubscribe POST'
        }
        {
          name: 'endpoint'
          optionName: 'endpoint'
          title: 'Endpoint (alternative)'
          type: 'text'
          serverDataBindings: true
          defaultValue: ''
          help: 'Or bind {{$_POST.endpoint}} when subscription JSON is not sent'
        }
        {
          name: 'userUUID'
          optionName: 'userUUID'
          title: 'User ID (passthrough)'
          type: 'text'
          serverDataBindings: true
          defaultValue: ''
          help: 'Optional audit field (e.g. {{$_POST.userUUID}})'
        }
        {
          name: 'entityId'
          optionName: 'entityId'
          title: 'Entity ID (passthrough)'
          type: 'text'
          serverDataBindings: true
          defaultValue: ''
          help: 'Optional audit field (e.g. {{$_POST.entityId}})'
        }
      ]
    }
  ]
}
